# Firebase Authentication & Project Configuration
# Copy this file to `.env.local` and replace with your project values from Firebase Console:
# Project Settings -> General -> Your apps -> Web app (SDK setup and configuration)

VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdef
VITE_FIREBASE_AUTH_DOMAIN=your-portfolio-crm.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-portfolio-crm
VITE_FIREBASE_STORAGE_BUCKET=your-portfolio-crm.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
