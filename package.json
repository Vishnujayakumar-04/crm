{
  "name": "portfolio-crm",
  "private": true,
  "version": "1.0.0",
  "description": "Portfolio CRM — Personal Wealth & Investment Manager",
  "author": "Portfolio CRM",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "build:win": "vite build && electron-builder --win nsis",
    "build:portable": "vite build && electron-builder --win portable",
    "pack:win": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.portfoliocrm.desktop",
    "productName": "Portfolio CRM",
    "copyright": "Copyright © 2026 Portfolio CRM",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Portfolio CRM"
    }
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^1.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1"
  }
}
